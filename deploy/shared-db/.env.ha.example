# Create .env.ha with mode 0600 on each server; retain the original production
# cookie, session and PII keys in secrets/. Do not generate replacement keys.
# Percent-encode the generated password when placing it inside the URL.
SPARK_DATABASE_URL=postgresql+psycopg://spark:REPLACE_WITH_GENERATED_PASSWORD@127.0.0.1:15432/spark
SPARK_PUBLIC_BASE_URL=https://spark.oilu.cn
SPARK_STANDBY_MODE=true
# Preserve these values from the live production environment during deployment.
SPARK_EMAIL_ENABLED=false
SPARK_PUSH_ENABLED=false
RESEND_API_KEY=
RESEND_FROM=
# SPARK_RELEASE_IMAGE belongs in Compose's .env or the invoking environment.
# Its tag must identify the approved Git commit; never build a cloud patch.
