# Include in nginx's http context. Each node reaches the peer via SSH port 18900.
# Install only after both /health/ready checks and login/session tests pass.
upstream spark_cluster {
    server 127.0.0.1:8900 weight=1 max_fails=2 fail_timeout=15s;
    server 127.0.0.1:18900 weight=1 max_fails=2 fail_timeout=15s;
    keepalive 16;
}
# In the existing HTTPS server block's location /:
# proxy_pass http://spark_cluster;
# proxy_http_version 1.1;
# proxy_set_header Host $host;
# proxy_set_header Connection "";
# proxy_set_header X-Forwarded-Proto https;
# proxy_connect_timeout 3s;
# proxy_next_upstream error timeout http_502 http_503 http_504;
# Do not enable non_idempotent retries: POST requests must not be replayed.
