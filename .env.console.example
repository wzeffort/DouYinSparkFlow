SPARK_DATA_DIR=/data
SPARK_COOKIE_KEY_FILE=/run/secrets/cookie.key
SPARK_SESSION_KEY_FILE=/run/secrets/session.key
SPARK_WEB_BIND=0.0.0.0
SPARK_WEB_PORT=8899
SPARK_WEB_PUBLISH_IP=127.0.0.1
SPARK_SECURE_COOKIES=true
SPARK_TIMEZONE=Asia/Shanghai
# spark-worker 主任务轮询间隔（秒）。
SPARK_WORKER_POLL_SECONDS=10
SPARK_AUTH_POLL_SECONDS=1
SPARK_AUTH_WARM_MAX_AGE_SECONDS=120
SPARK_CLOCK_OFFSET_LIMIT_SECONDS=5
SPARK_BUILD_PIP_INDEX_URL=https://pypi.org/simple
SPARK_PII_KEY_FILE=/run/secrets/pii.key
SPARK_PUBLIC_BASE_URL=https://wangze.oilu.cn
SPARK_EMAIL_ENABLED=false
SPARK_EMAIL_POLL_SECONDS=10
SPARK_HEALTH_SNAPSHOT_PATH=/run/spark-health/host-health.json

# Resend 邮件服务。真实 API Key 只写入被 Git 忽略的 .env.console。
RESEND_API_KEY=
RESEND_FROM=DouYinSparkFlow <notify@oilu.cn>
